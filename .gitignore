.idea/
.editorconfig
/output/*
!output/.gitkeep
target/
commlog/
# Measured CSVs are primary data — without them the reports' figures cannot be rebuilt from a
# clone — so they are tracked while the bulky run logs are not.
benchmark/
__pycache__/
config/services.json.bench-backup

# Editor and diagram-tool leftovers. These were committed once; Software Heritage
# archives whatever it finds, so keep them out permanently.
*.bak
.$*
ARCHITECTURE.md
CLAUDE.md

# Maintained locally and committed only when cutting a release, so the tagged tree
# carries it: `git add -f CHANGELOG.md`. Day-to-day provenance (FAIR4RS R1.2) comes
# from the conventional commit history, not from this file.
CHANGELOG.md

# Narrative, planning and derived material: kept locally, not tracked.
# Same rule as ARCHITECTURE.md / CLAUDE.md above — the repo tracks source and the
# tooling that produces these, not the documents themselves.
docs/
benchmark/
