.idea/
.editorconfig
/output/*
!output/.gitkeep
target/
commlog/
# Measured CSVs are primary data — without them the reports' figures cannot be rebuilt from a
# clone — so they are tracked while the bulky run logs are not.
benchmark/
__pycache__/
config/services.json.bench-backup

# Editor and diagram-tool leftovers. These were committed once; Software Heritage
# archives whatever it finds, so keep them out permanently.
*.bak
.$*
ARCHITECTURE.md
CLAUDE.md

# CHANGELOG.md is deliberately NOT ignored. It is the only place a released version's
# Software Heritage identifiers are recorded, and FAIR4RS F3 ("metadata include the
# identifier") and R1.2 (provenance) require that record to travel with the software.
# There is no SWH equivalent of a Zenodo concept DOI, so this file is the substitute.

# Narrative, planning and derived material: kept locally, not tracked.
# Same rule as ARCHITECTURE.md / CLAUDE.md above — the repo tracks source and the
# tooling that produces these, not the documents themselves.
docs/
INTEROP_PLAN.md
BENCHMARK_PLAN.md
bathesis.md
validate.md
benchmark/CASE_STUDY_THROUGHPUT.md
benchmark/figures/
benchmark/REPORT_THROUGHPUT.md
benchmark/REPORT_SOCKET_PAIR.md
benchmark/REPORT_COMBINED.md
benchmark/REPORT_KINK_TCP.md
