<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.framed</groupId>
    <artifactId>framed-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>framed-benchmark</artifactId>

  <name>FRAMED Benchmark</name>
  <description>Performance measurements across module boundaries: does a deployment sustain the
    input cadence of its devices end to end? Test sources only — this module ships nothing. Like
    framed-app it is a consumer of the framework, so it may depend on several leaf modules at once
    (which the leaves themselves must never do); nothing depends back into it.</description>

  <properties>
    <!-- Measurements, not a library: never install or deploy this module's (empty) artifact. -->
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
    <!-- Excluded from the aggregate Javadoc for the same reason. -->
    <maven.javadoc.skip>true</maven.javadoc.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.framed</groupId>
      <artifactId>framed-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Producer under measurement (MimicReplayProtocol). -->
    <dependency>
      <groupId>com.framed</groupId>
      <artifactId>framed-communicator</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Sink under measurement (CountingDispatcher). -->
    <dependency>
      <groupId>com.framed</groupId>
      <artifactId>framed-streamer</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.json</groupId>
      <artifactId>json</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- No main sources; skip the empty jar rather than publishing a meaningless artifact. -->
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <version>${maven-jar-plugin.version}</version>
        <executions>
          <execution>
            <id>default-jar</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>