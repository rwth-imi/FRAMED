{
  "Dispatchers": [
    {
      "class": "com.framed.streamer.dispatcher.CountingDispatcher",
      "id": "Counting",
      "devices": ["CDSS"],
      "channels": ["Kink", "Kink-Probability"]
    },
    {
      "class": "com.framed.streamer.dispatcher.JsonlDispatcher",
      "id": "Classification-Capture",
      "devices": ["CDSS"],
      "path": "@CAPTURE_DIR@",
      "fileName": "classifications.jsonl"
    }
  ],
  "Devices": [
    {
      "class": "com.framed.communicator.driver.protocol.replay.ReplayProtocol",
      "id": "Kink-Replay",
      "filePath": "@RECORD@",
      "devices": ["Oxylog-3000-Plus-00", "PC60FW"],
      "channels": [],
      "speed": @SPEED@,
      "startDelaySeconds": @START_DELAY@,
      "graceSeconds": @GRACE@,
      "exitOnCompletion": true
    }
  ]
}
