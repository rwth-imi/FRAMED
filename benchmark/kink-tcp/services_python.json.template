{
  "Reactors": [
    {
      "class": "pyframed.cdss.reactors.feature_scaling_reactor.FeatureScalingReactor",
      "id": "Kink-Feature-Scaler",
      "modelPath": "@MODEL@",
      "outputChannels": ["Kink-Features"],
      "device": "Oxylog-3000-Plus-00",
      "windowS": 6.0,
      "emitEvery": 1,
      "includePulseOx": false,
      "staleTimeoutS": 3.0,
      "atomic": true,
      "latencyInstrumentation": "global"
    },
    {
      "class": "pyframed.cdss.reactors.pca_reduction_reactor.PCAReductionReactor",
      "id": "Kink-Reducer",
      "modelPath": "@MODEL@",
      "inputChannel": "Kink-Features",
      "outputChannels": ["Kink-Components"],
      "components": 10,
      "componentSelection": "variance",
      "atomic": true,
      "latencyInstrumentation": "global"
    },
    {
      "class": "pyframed.cdss.reactors.kink_classification_reactor.KinkClassificationReactor",
      "id": "Kink-Classifier",
      "modelPath": "@MODEL@",
      "inputChannel": "Kink-Components",
      "outputChannels": ["Kink", "Kink-Probability"],
      "threshold": 0.4,
      "persistWindows": 1,
      "atomic": true,
      "latencyInstrumentation": "global"
    }
  ]
}
