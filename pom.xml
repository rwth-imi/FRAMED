<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.framed</groupId>
  <artifactId>framed-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>FRAMED (parent)</name>
  <description>Service-oriented framework for acquiring and integrating data from multiple sources.</description>

  <modules>
    <module>framed-core</module>
    <module>framed-communicator</module>
    <module>framed-streamer</module>
    <module>framed-cdss</module>
    <module>framed-interop</module>
    <module>framed-app</module>
    <module>framed-benchmark</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>

    <maven-compiler-plugin.version>3.11.0</maven-compiler-plugin.version>
    <maven-shade-plugin.version>3.2.4</maven-shade-plugin.version>
    <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
    <exec-maven-plugin.version>3.0.0</exec-maven-plugin.version>
    <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
    <maven-jar-plugin.version>3.4.1</maven-jar-plugin.version>

    <junit-jupiter.version>5.9.1</junit-jupiter.version>
    <json.version>20250517</json.version>
    <influxdb.version>7.4.0</influxdb.version>
    <jserialcomm.version>2.10.4</jserialcomm.version>
    <paho.version>1.2.5</paho.version>
    <moquette.version>0.17</moquette.version>
    <sdcri.version>6.2.1</sdcri.version>
    <log4j.version>2.24.1</log4j.version>

    <launcher.class>com.framed.orchestrator.Main</launcher.class>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.framed</groupId>
        <artifactId>framed-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.framed</groupId>
        <artifactId>framed-communicator</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.framed</groupId>
        <artifactId>framed-streamer</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.framed</groupId>
        <artifactId>framed-cdss</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.framed</groupId>
        <artifactId>framed-interop-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <!-- Shared test fixtures (ReplayFixture) for the interop bridge simulations. -->
        <groupId>com.framed</groupId>
        <artifactId>framed-interop-common</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.framed</groupId>
        <artifactId>framed-interop-hl7</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.framed</groupId>
        <artifactId>framed-interop-mqtt</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.framed</groupId>
        <artifactId>framed-interop-sdc</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>org.json</groupId>
        <artifactId>json</artifactId>
        <version>${json.version}</version>
      </dependency>
      <dependency>
        <groupId>com.influxdb</groupId>
        <artifactId>influxdb-client-java</artifactId>
        <version>${influxdb.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fazecast</groupId>
        <artifactId>jSerialComm</artifactId>
        <version>${jserialcomm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.paho</groupId>
        <artifactId>org.eclipse.paho.client.mqttv3</artifactId>
        <version>${paho.version}</version>
      </dependency>
      <dependency>
        <groupId>io.moquette</groupId>
        <artifactId>moquette-broker</artifactId>
        <version>${moquette.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.somda.sdc</groupId>
        <artifactId>glue</artifactId>
        <version>${sdcri.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-core</artifactId>
        <version>${log4j.version}</version>
        <scope>test</scope>
      </dependency>

      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter-api</artifactId>
        <version>${junit-jupiter.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter-engine</artifactId>
        <version>${junit-jupiter.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <compilerArgs>
            <arg>-parameters</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <!-- Keep the main jar modular (module-info) but run tests on the classpath to
               avoid JPMS test-readability friction; tests use white-box access to internals. -->
          <useModulePath>false</useModulePath>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>${maven-javadoc-plugin.version}</version>
        <configuration>
          <!-- Published API: document protected+public members, not private internals. -->
          <show>protected</show>
          <nohelp>true</nohelp>
          <doctitle>FRAMED API</doctitle>
          <windowtitle>FRAMED API</windowtitle>
          <!-- FRAMED theme + logo banner injected on every page. The stylesheet lives in
               src/main/javadoc/ and is layered over the standard one. -->
          <javadocDirectory>${project.basedir}/src/main/javadoc</javadocDirectory>
          <addStylesheets>
            <addStylesheet>framed-javadoc.css</addStylesheet>
          </addStylesheets>
          <top><![CDATA[<div class="framed-banner"><img class="framed-logo" src="https://raw.githubusercontent.com/rwth-imi/FRAMED/master/images/logo_dark.png" alt="FRAMED"/><span class="framed-title">FRAMED API</span></div>]]></top>
          <!-- Exclude module-info so the aggregate report treats every module as unnamed;
               javadoc cannot aggregate a mix of named (framed-core) and unnamed modules. -->
          <sourceFileExcludes>
            <sourceFileExclude>**/module-info.java</sourceFileExclude>
          </sourceFileExcludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
